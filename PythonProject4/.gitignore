# macOS system files
.DS_Store

# IDE / Code Editor configuration files
.idea/
.vscode/

# Python caching and build files
__pycache__/
*.pyc

# Compressed file archives
*.zip
*.tar.gz

# Ignore all event data folders
event_*/

# Ignore machine learning models and heavy training checkouts
# Ignore everything in discourse by default
discourse/*

# Keep lightweight inference code in Git
!discourse/__init__.py
!discourse/infer_deberta_pdtb.py

# Keep large model/checkpoint directories out of Git
discourse/models/
discourse/deberta_pdtb_english_style/

# Ignore model weight files globally
*.pt
*.bin
DP/

# Backup files
*.bak
*~

# Generated validation outputs
multi_event_framing_project/validation_outputs/*
!multi_event_framing_project/validation_outputs/article_relevance_audit.csv
!multi_event_framing_project/validation_outputs/article_relevance_audit_1.csv
