def compute_emotion_distribution(tokens, emotion_lexicon):
    counts = {
        emotion: 0
        for emotion in EMOTION_CATEGORIES
    }

    total = 0

    for token in tokens:
        if token in emotion_lexicon:
            for emotion in emotion_lexicon[token]:
                if emotion in counts:
                    counts[emotion] += 1
                    total += 1

    if total == 0:
        return {
            emotion: 0.0
            for emotion in EMOTION_CATEGORIES
        }

    return {
        emotion: counts[emotion] / total
        for emotion in EMOTION_CATEGORIES
    }

def add_emotional_amplification(
        df,
        vad_lexicon,
        emotion_lexicon
):
    df = df.copy()

    df["tokens"] = df["text"].apply(tokenize_words)

    df["vad_emotional_intensity"] = (
        df["tokens"]
        .apply(
            lambda tokens:
            compute_vad_emotional_intensity(
                tokens,
                vad_lexicon
            )
        )
    )

    emotion_profiles = (
        df["tokens"]
        .apply(
            lambda tokens:
            compute_emotion_distribution(
                tokens,
                emotion_lexicon
            )
        )
    )

    for emotion in EMOTION_CATEGORIES:
        df[f"emotion_{emotion}_rate"] = (
            emotion_profiles
            .apply(
                lambda profile:
                profile[emotion]
            )
        )

    vad_consensus = df["vad_emotional_intensity"].mean()

    df["vad_intensity_deviation"] = (
        df["vad_emotional_intensity"]
        .apply(
            lambda value:
            normalized_deviation(
                value,
                vad_consensus
            )
        )
    )

    emotion_deviation_columns = []

    for emotion in EMOTION_CATEGORIES:
        column = f"emotion_{emotion}_rate"
        deviation_column = f"{column}_deviation"

        consensus = df[column].mean()

        df[deviation_column] = (
            df[column]
            .apply(
                lambda value:
                normalized_deviation(
                    value,
                    consensus
                )
            )
        )

        emotion_deviation_columns.append(deviation_column)

    df["emotion_distribution_deviation"] = (
        df[emotion_deviation_columns]
        .mean(axis=1)
    )

    df["emotional_amplification_deviation"] = (
        df[
            [
                "vad_intensity_deviation",
                "emotion_distribution_deviation"
            ]
        ]
        .mean(axis=1)
    )

    return df.drop(columns=["tokens"])

