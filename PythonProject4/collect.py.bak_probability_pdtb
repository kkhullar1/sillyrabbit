def softmax(scores):
    scores = np.array(scores, dtype=float)
    scores = scores - np.max(scores)

    exp_scores = np.exp(scores)
    denominator = exp_scores.sum()

    if denominator == 0:
        return np.ones(len(scores)) / len(scores)

    return exp_scores / denominator


def normalize_probability_vector(vector):
    vector = np.array(vector, dtype=float)
    vector = np.clip(vector, 1e-12, None)

    total = vector.sum()

    if total == 0:
        return np.ones(len(vector)) / len(vector)

    return vector / total


def jensen_shannon_divergence(p, q):
    p = normalize_probability_vector(p)
    q = normalize_probability_vector(q)

    midpoint = 0.5 * (p + q)

    kl_pm = np.sum(
        p * np.log(p / midpoint)
    )

    kl_qm = np.sum(
        q * np.log(q / midpoint)
    )

    return float(
        0.5 * kl_pm + 0.5 * kl_qm
    )


def split_into_claim_units(text):
    sentences = re.split(
        r"(?<=[.!?])\s+",
        str(text)
    )

    return [
        sentence.strip()
        for sentence in sentences
        if len(sentence.strip().split()) >= 8
    ][:40]


def get_stance_targets(event_query):
    query = event_query.lower().strip()

    if query in STANCE_TARGETS:
        return STANCE_TARGETS[query]

    return [
        term
        for term in query.split()
        if len(term) > 3
    ]


def sentence_mentions_target(sentence, target):
    sentence_lower = sentence.lower()

    target_terms = [
        term
        for term in target.lower().split()
        if len(term) > 2
    ]

    return any(
        term in sentence_lower
        for term in target_terms
    )


def estimate_target_stance_for_unit(text_unit, target):
    unit_embedding = EMBEDDING_MODEL.encode(
        [str(text_unit)],
        normalize_embeddings=True
    )

    prompts = [
        f"This text supports {target}.",
        f"This text opposes {target}.",
        f"This text neutrally describes {target}."
    ]

    prompt_embeddings = EMBEDDING_MODEL.encode(
        prompts,
        normalize_embeddings=True
    )

    similarities = cosine_similarity(
        unit_embedding,
        prompt_embeddings
    ).flatten()

    probabilities = softmax(similarities)

    return {
        "favor": float(probabilities[0]),
        "against": float(probabilities[1]),
        "neutral": float(probabilities[2])
    }


def estimate_target_stance_for_article(text, target):
    claim_units = split_into_claim_units(text)

    target_units = [
        unit
        for unit in claim_units
        if sentence_mentions_target(unit, target)
    ]

    if len(target_units) == 0:
        target_units = claim_units[:10]

    if len(target_units) == 0:
        return {
            "favor": 0.0,
            "against": 0.0,
            "neutral": 1.0
        }

    unit_profiles = [
        estimate_target_stance_for_unit(unit, target)
        for unit in target_units
    ]

    return {
        stance_class: float(
            np.mean(
                [
                    profile[stance_class]
                    for profile in unit_profiles
                ]
            )
        )
        for stance_class in STANCE_CLASSES
    }


def estimate_article_stance_profile(text, targets):
    target_profiles = [
        estimate_target_stance_for_article(text, target)
        for target in targets
    ]

    if len(target_profiles) == 0:
        return {
            "favor": 0.0,
            "against": 0.0,
            "neutral": 1.0
        }

    return {
        stance_class: float(
            np.mean(
                [
                    profile[stance_class]
                    for profile in target_profiles
                ]
            )
        )
        for stance_class in STANCE_CLASSES
    }


def stance_profile_to_vector(profile):
    return np.array(
        [
            profile["favor"],
            profile["against"],
            profile["neutral"]
        ],
        dtype=float
    )


def add_stance_misalignment(df, event_query):
    df = df.copy()

    targets = get_stance_targets(event_query)

    stance_profiles = (
        df["text"]
        .apply(
            lambda text:
            estimate_article_stance_profile(
                text,
                targets
            )
        )
    )

    article_vectors = stance_profiles.apply(
        stance_profile_to_vector
    )

    consensus_vector = np.mean(
        np.vstack(article_vectors.values),
        axis=0
    )

    consensus_vector = normalize_probability_vector(
        consensus_vector
    )

    df["stance_distribution_js_divergence"] = (
        article_vectors
        .apply(
            lambda vector:
            jensen_shannon_divergence(
                vector,
                consensus_vector
            )
        )
    )

    df["stance_misalignment_deviation"] = (
        df["stance_distribution_js_divergence"]
    )

    return df

