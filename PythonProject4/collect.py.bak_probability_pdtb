def build_tfidf_matrix(texts, max_features=1500):
    vectorizer = TfidfVectorizer(
        stop_words="english",
        max_features=max_features,
        ngram_range=(1, 2)
    )

    matrix = vectorizer.fit_transform(
        [str(text) for text in texts]
    )

    terms = vectorizer.get_feature_names_out()

    return vectorizer, matrix, terms

def get_common_tfidf_terms(df, top_n=25):
    if df.empty or "text" not in df.columns:
        return []

    _, matrix, terms = build_tfidf_matrix(df["text"])

    tfidf_df = pd.DataFrame(
        matrix.toarray(),
        columns=terms
    )

    document_presence = (tfidf_df > 0).sum(axis=0)

    minimum_articles = max(
        2,
        int(np.ceil(len(df) * 0.40))
    )

    common_terms = document_presence[
        document_presence >= minimum_articles
        ].index.tolist()

    if len(common_terms) == 0:
        common_terms = list(terms)

    ranked_terms = (
        tfidf_df[common_terms]
        .mean(axis=0)
        .sort_values(ascending=False)
        .head(top_n)
        .index
        .tolist()
    )

    return ranked_terms

def add_tfidf_discourse_emphasis(df):
    df = df.copy()

    if df.empty:
        df["tfidf_discourse_emphasis_deviation"] = []
        return df

    _, matrix, terms = build_tfidf_matrix(df["text"])

    tfidf_df = pd.DataFrame(
        matrix.toarray(),
        columns=terms,
        index=df.index
    )

    common_terms = get_common_tfidf_terms(df, top_n=25)

    if len(common_terms) == 0:
        df["tfidf_discourse_emphasis_deviation"] = 0.0
        df["salient_common_event_terms"] = ""
        return df

    emphasis_matrix = tfidf_df[common_terms]

    consensus_vector = emphasis_matrix.mean(axis=0)

    deviations = []

    for idx in df.index:
        article_vector = emphasis_matrix.loc[idx]

        deviation = np.mean(
            np.abs(
                article_vector - consensus_vector
            )
        )

        deviations.append(float(deviation))

    df["tfidf_discourse_emphasis_deviation"] = deviations

    df["tfidf_discourse_emphasis"] = (
        emphasis_matrix.sum(axis=1)
    )

    df["salient_common_event_terms"] = [
                                           ", ".join(common_terms)
                                       ] * len(df)

    return df

def add_omission_scores(df):
    df = df.copy()

    if df.empty:
        df["omission_score"] = []
        return df

    _, matrix, terms = build_tfidf_matrix(df["text"])

    tfidf_df = pd.DataFrame(
        matrix.toarray(),
        columns=terms,
        index=df.index
    )

    top_event_terms = (
        tfidf_df
        .mean(axis=0)
        .sort_values(ascending=False)
        .head(20)
        .index
        .tolist()
    )

    omission_scores = []

    for idx in df.index:
        article_terms = (
            tfidf_df
            .loc[idx]
            .sort_values(ascending=False)
            .head(50)
            .index
            .tolist()
        )

        missing_terms = set(top_event_terms) - set(article_terms)

        score = len(missing_terms) / max(
            len(top_event_terms),
            1
        )

        omission_scores.append(float(score))

    df["omission_score"] = omission_scores

    return df

def add_semantic_content_deviation(df):
    df = df.copy()

    if df.empty:
        df["content_deviation_deviation"] = []
        return df

    texts = [
        str(text)[:3000]
        for text in df["text"]
    ]

    embeddings = EMBEDDING_MODEL.encode(
        texts,
        normalize_embeddings=True
    )

    consensus = np.mean(
        embeddings,
        axis=0
    )

    consensus = consensus / max(
        np.linalg.norm(consensus),
        1e-12
    )

    similarities = cosine_similarity(
        embeddings,
        consensus.reshape(1, -1)
    ).flatten()

    df["content_similarity_to_consensus"] = similarities

    df["content_deviation"] = 1 - similarities

    consensus_deviation = df["content_deviation"].mean()

    df["content_deviation_deviation"] = (
        df["content_deviation"]
        .apply(
            lambda value:
            normalized_deviation(
                value,
                consensus_deviation
            )
        )
    )

    return df

def load_vad_lexicon(path):
    vad_df = pd.read_csv(path, sep="\t")
    vad_df.columns = [
        column.strip().lower()
        for column in vad_df.columns
    ]

    print("VAD columns found:", vad_df.columns.tolist())

    word_column = vad_df.columns[0]
    valence_column = (
        "valence"
        if "valence" in vad_df.columns
        else vad_df.columns[1]
    )
    arousal_column = (
        "arousal"
        if "arousal" in vad_df.columns
        else vad_df.columns[2]
    )
    dominance_column = (
        "dominance"
        if "dominance" in vad_df.columns
        else vad_df.columns[3]
    )

    return {
        str(row[word_column]).lower(): (
            float(row[valence_column]),
            float(row[arousal_column]),
            float(row[dominance_column])
        )
        for _, row in vad_df.iterrows()
    }

def load_emotion_lexicon(path):
    emotion_df = pd.read_csv(
        path,
        sep="\t",
        header=None,
        names=[
            "word",
            "emotion",
            "association"
        ]
    )

    emotion_df = emotion_df[
        emotion_df["association"] == 1
        ]

    lexicon = {}

    for word, group in emotion_df.groupby("word"):
        lexicon[str(word).lower()] = set(
            group["emotion"]
        )

    return lexicon

def tokenize_words(text):
    if pd.isna(text):
        return []

    return re.findall(
        r"[a-z]+",
        str(text).lower()
    )

def compute_vad_emotional_intensity(tokens, vad_lexicon):
    scores = []

    for token in tokens:
        if token in vad_lexicon:
            valence, arousal, dominance = vad_lexicon[token]

            valence_intensity = abs(valence - 0.5) * 2
            dominance_intensity = abs(dominance - 0.5) * 2

            scores.append(
                np.mean(
                    [
                        valence_intensity,
                        arousal,
                        dominance_intensity
                    ]
                )
            )

    if len(scores) == 0:
        return 0.0

    return float(np.mean(scores))

