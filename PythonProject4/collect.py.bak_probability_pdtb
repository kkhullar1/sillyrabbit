DISCOVERED_EVENTS_DIR = PROJECT_DIR / "discovered_events"
DISCOVERED_EVENTS_DIR.mkdir(parents=True, exist_ok=True)

DISCOVERY_MIN_ARTICLES = 4
DISCOVERY_MIN_SOURCES = 3
DISCOVERY_MIN_AVG_PAIRWISE_SIM = 0.42
DISCOVERY_CLUSTER_DISTANCE_THRESHOLD = 0.55


def collect_broad_rss_articles():
    rows = []
    seen_urls = set()

    for source, feeds in RSS_FEEDS.items():
        print("Broad scan:", source)

        for feed_url in feeds:
            items = get_feed_items(feed_url)

            for item in items:
                url = item.get("link", "")

                if not url or url in seen_urls:
                    continue

                seen_urls.add(url)

                rows.append(
                    {
                        "source": source,
                        "title": item.get("title", ""),
                        "summary": item.get("summary", ""),
                        "url": url,
                        "published": item.get("published", "")
                    }
                )

    return pd.DataFrame(rows)


def extract_broad_articles(article_df):
    rows = []

    for _, row in article_df.iterrows():
        text = extract_text(row["url"])

        if text is None:
            continue

        rows.append(
            {
                "source": row["source"],
                "title": row["title"],
                "summary": row["summary"],
                "url": row["url"],
                "published": row["published"],
                "text": text
            }
        )

    return pd.DataFrame(rows)


def add_article_embeddings(df):
    df = df.copy()

    texts = (
        df["title"].astype(str)
        + " "
        + df["summary"].astype(str)
        + " "
        + df["text"].astype(str).str[:1500]
    ).tolist()

    embeddings = EMBEDDING_MODEL.encode(
        texts,
        normalize_embeddings=True
    )

    df["embedding"] = list(embeddings)

    return df


def cluster_articles(df):
    df = df.copy()

    if len(df) < DISCOVERY_MIN_ARTICLES:
        df["cluster_id"] = -1
        return df

    embeddings = np.vstack(df["embedding"].values)

    clustering = AgglomerativeClustering(
        n_clusters=None,
        metric="cosine",
        linkage="average",
        distance_threshold=DISCOVERY_CLUSTER_DISTANCE_THRESHOLD
    )

    df["cluster_id"] = clustering.fit_predict(embeddings)

    return df


def compute_cluster_quality(cluster_df):
    embeddings = np.vstack(cluster_df["embedding"].values)

    similarity_matrix = cosine_similarity(embeddings)

    pairwise_values = similarity_matrix[
        np.triu_indices_from(
            similarity_matrix,
            k=1
        )
    ]

    avg_pairwise_similarity = (
        float(np.mean(pairwise_values))
        if len(pairwise_values) > 0
        else 0.0
    )

    return {
        "article_count": len(cluster_df),
        "source_count": cluster_df["source"].nunique(),
        "avg_pairwise_similarity": avg_pairwise_similarity
    }


def validate_cluster(cluster_df):
    quality = compute_cluster_quality(cluster_df)

    if quality["article_count"] < DISCOVERY_MIN_ARTICLES:
        return False, "too_few_articles", quality

    if quality["source_count"] < DISCOVERY_MIN_SOURCES:
        return False, "too_few_sources", quality

    if quality["avg_pairwise_similarity"] < DISCOVERY_MIN_AVG_PAIRWISE_SIM:
        return False, "low_similarity", quality

    return True, "accepted", quality


def make_cluster_label(cluster_df):
    terms = get_common_tfidf_terms(
        cluster_df,
        top_n=5
    )

    if not terms:
        return "unlabeled_event"

    label = "_".join(terms)

    label = re.sub(
        r"[^a-zA-Z0-9]+",
        "_",
        label
    )

    return label.strip("_")[:80]


def save_discovered_event(
        cluster_df,
        cluster_id,
        quality,
        vad_lexicon,
        emotion_lexicon
):
    label = make_cluster_label(cluster_df)

    event_folder = (
        DISCOVERED_EVENTS_DIR
        /
        f"cluster_{cluster_id}_{label}"
    )

    event_folder.mkdir(
        parents=True,
        exist_ok=True
    )

    cluster_df.to_csv(
        event_folder / "articles.csv",
        index=False
    )

    feature_df, labeled_feature_df = compute_features(
        cluster_df,
        label,
        event_folder,
        vad_lexicon,
        emotion_lexicon
    )

    feature_df.to_csv(
        event_folder / "framing_dataset.csv",
        index=False
    )

    labeled_feature_df.to_csv(
        event_folder / "proposal_labeled_features.csv",
        index=False
    )

    return event_folder


def run_discovered_events(vad_lexicon, emotion_lexicon):
    print("=" * 60)
    print("DISCOVERED EVENTS MODE")
    print("=" * 60)

    raw_df = collect_broad_rss_articles()

    raw_df.to_csv(
        DISCOVERED_EVENTS_DIR / "raw_rss_candidates.csv",
        index=False
    )

    extracted_df = extract_broad_articles(raw_df)

    extracted_df.to_csv(
        DISCOVERED_EVENTS_DIR / "extracted_articles.csv",
        index=False
    )

    if len(extracted_df) < DISCOVERY_MIN_ARTICLES:
        print("Too few articles for discovery.")
        return

    embedded_df = add_article_embeddings(extracted_df)

    clustered_df = cluster_articles(embedded_df)

    quality_rows = []

    accepted_count = 0

    for cluster_id, cluster_df in clustered_df.groupby("cluster_id"):
        if cluster_id == -1:
            continue

        accepted, reason, quality = validate_cluster(cluster_df)

        quality_rows.append(
            {
                "cluster_id": cluster_id,
                "accepted": accepted,
                "rejection_reason": reason,
                "article_count": quality["article_count"],
                "source_count": quality["source_count"],
                "avg_pairwise_similarity": quality["avg_pairwise_similarity"]
            }
        )

        if not accepted:
            continue

        event_folder = save_discovered_event(
            cluster_df,
            cluster_id,
            quality,
            vad_lexicon,
            emotion_lexicon
        )

        print("Saved discovered event:", event_folder)

        accepted_count += 1

    quality_df = pd.DataFrame(quality_rows)

    quality_df.to_csv(
        DISCOVERED_EVENTS_DIR / "quality_report.csv",
        index=False
    )

    print("Accepted discovered events:", accepted_count)


